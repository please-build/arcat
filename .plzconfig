[parse]
preloadsubincludes = ///go//build_defs:go

[please]
version = >=17.21.0

[Plugin "go"]
Target = //plugins:go
pleasegotool = ///go//tools/please_go:bootstrap
gotool = //third_party/go:toolchain|go
importpath = github.com/please-build/arcat

[alias "puku"]
cmd = run //third_party/binary:puku --
positionallabels = true
subcommand = fmt
subcommand = licences
subcommand = lint
subcommand = migrate
subcommand = sync
subcommand = version
subcommand = watch
